NODE_ENV=development
PORT=3001

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=products_user
PGPASSWORD=changeme
PGDATABASE=products_db

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# OpenTelemetry — solo configura el endpoint de tu collector, el código ya
# está instrumentado (HTTP, Express, PostgreSQL, métricas).
OTEL_ENABLED=true
OTEL_SERVICE_NAME=products-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Opcional, formato "key1=value1,key2=value2" (ej. para backends que piden API key/token)
OTEL_EXPORTER_OTLP_HEADERS=
